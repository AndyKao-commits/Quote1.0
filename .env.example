# Use YOUR Supabase project (Dashboard → Project Settings → API → Legacy keys)
# Project ref is in the URL: https://supabase.com/dashboard/project/<PROJECT_REF>/...

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-legacy-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-legacy-key
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=your-service-role-legacy-key

# Optional: AI 客服 / 估價單掃描
LOVABLE_API_KEY=

# Auth → URL Configuration (after deploy)
# Site URL: https://dowaterlightout.vercel.app
# Redirect URLs: https://dowaterlightout.vercel.app/**  http://localhost:5173/**

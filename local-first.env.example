VITE_LOCAL_FIRST=true
VITE_LOCAL_MOCK_API=http://127.0.0.1:3099
VITE_LOCAL_MOCK_SECRET=bdg-local-dev-secret-change-me

# 授權服務（mock:api 腳本）
LOCAL_MOCK_PORT=3099
LOCAL_MOCK_SECRET=bdg-local-dev-secret-change-me
